<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>3D Truck Driving Simulator</title>
  <style>
    body { margin: 0; overflow: hidden; }
    #info { position: absolute; top: 10px; left: 10px; color: #fff; font-family: sans-serif; z-index: 1; }
  </style>
</head>
<body>
  <div id="info">Use WASD or Arrow Keys to drive the truck</div>
  <script src="https://unpkg.com/three@0.150.1/build/three.min.js"></script>
  <script src="https://unpkg.com/three@0.150.1/examples/js/controls/OrbitControls.js"></script>
  <script src="https://unpkg.com/three@0.150.1/examples/js/loaders/GLTFLoader.js"></script>
  <script>
    let scene, camera, renderer, truck;
    let speed = 0;
    let steeringAngle = 0;
    const maxSpeed = 0.2;
    const acceleration = 0.002;
    const deceleration = 0.005;
    const turnSpeed = 0.04;
    const keys = {};

    init();
    animate();

    function init() {
      // Scene
      scene = new THREE.Scene();
      scene.background = new THREE.Color(0x87ceeb);

      // Camera
      camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
      camera.position.set(0, 5, -10);

      // Renderer
      renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      document.body.appendChild(renderer.domElement);

      // Lights
      const hemiLight = new THREE.HemisphereLight(0xffffff, 0x444444, 1.2);
      hemiLight.position.set(0, 20, 0);
      scene.add(hemiLight);

      const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
      dirLight.position.set(-5, 10, -5);
      scene.add(dirLight);

      // Ground
      const groundGeo = new THREE.PlaneGeometry(200, 200);
      const groundMat = new THREE.MeshStandardMaterial({ color: 0x228b22 });
      const ground = new THREE.Mesh(groundGeo, groundMat);
      ground.rotation.x = -Math.PI / 2;
      ground.receiveShadow = true;
      scene.add(ground);

      // Controls (for camera orbiting)
      const controls = new THREE.OrbitControls(camera, renderer.domElement);
      controls.target.set(0, 1, 0);
      controls.update();

      // Load Truck Model
      const loader = new THREE.GLTFLoader();
      loader.load('models/truck/scene.gltf', function (gltf) {
        truck = gltf.scene;
        truck.scale.set(0.005, 0.005, 0.005);
        truck.position.set(0, 0, 0);
        scene.add(truck);
      });

      // Resize Handler
      window.addEventListener('resize', onWindowResize, false);
      // Keyboard Handlers
      window.addEventListener('keydown', (e) => keys[e.code] = true);
      window.addEventListener('keyup', (e) => keys[e.code] = false);
    }

    function onWindowResize() {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    }

    function handleInput() {
      // Forward
      if (keys['KeyW'] || keys['ArrowUp']) {
        speed = Math.min(maxSpeed, speed + acceleration);
      }
      // Backward
      else if (keys['KeyS'] || keys['ArrowDown']) {
        speed = Math.max(-maxSpeed / 2, speed - acceleration);
      }
      else {
        // Natural deceleration
        if (speed > 0) speed = Math.max(0, speed - deceleration);
        if (speed < 0) speed = Math.min(0, speed + deceleration);
      }

      // Steering
      if (keys['KeyA'] || keys['ArrowLeft']) {
        steeringAngle = turnSpeed;
      } else if (keys['KeyD'] || keys['ArrowRight']) {
        steeringAngle = -turnSpeed;
      } else {
        steeringAngle = 0;
      }
    }

    function animate() {
      requestAnimationFrame(animate);
      if (truck) {
        handleInput();
        // Rotate truck
        truck.rotation.y += steeringAngle * (speed / maxSpeed);
        // Move truck forward in its local coordinate
        const forward = new THREE.Vector3(0, 0, 1).applyQuaternion(truck.quaternion);
        truck.position.add(forward.multiplyScalar(speed));
        // Camera follows
        camera.position.lerp(new THREE.Vector3(
          truck.position.x - forward.x * 10,
          truck.position.y + 5,
          truck.position.z - forward.z * 10
        ), 0.1);
        camera.lookAt(truck.position.x, truck.position.y + 1, truck.position.z);
      }
      renderer.render(scene, camera);
    }
  </script>
</body>
</html>
